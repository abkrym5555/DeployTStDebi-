pipeline{
    agent any
    
    stages{
        stage("build docker image"){
            steps{
              script {
                sh "docker build -t docker-react-proj -f Dockerfile.dev ."
              }
         }
      }
      stage("run tests"){
        steps{
          script {
            sh "docker run -e CI=true docker-react-proj npm run test"
          }
        }
      }
    }
  }

